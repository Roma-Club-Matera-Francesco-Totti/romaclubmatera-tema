<?xml version="1.0" encoding="utf-8"?>
<!-- 30 minuti: il "fra N giorni" si ricalcola, il sito si legge al massimo ogni 3 ore -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_partita_descrizione"
    android:initialLayout="@layout/widget_partita"
    android:minWidth="250dp"
    android:minHeight="40dp"
