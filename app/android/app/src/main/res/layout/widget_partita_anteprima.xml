<?xml version="1.0" encoding="utf-8"?>
<!-- Come appare nell'elenco dei widget del telefono (Android 12+) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rcm_widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="60dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/rcm_widget_stemma" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:text="FRA 4 GIORNI · SERIE A, 7ª GIORNATA"
            android:textColor="#E3AD1E"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="ROMA – GENOA"
            android:textColor="#F6ECD0"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="Sabato 17 ottobre · 20:45 · DAZN"
            android:textColor="#D9F6ECD0"
            android:textSize="13sp" />

    </LinearLayout>
</LinearLayout>
