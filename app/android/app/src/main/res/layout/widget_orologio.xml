<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Orologio giallorosso": l'ora la tiene il sistema (TextClock) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rcm_widget_fondo"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="46dp"
        android:layout_height="54dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/rcm_widget_stemma" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="#F6ECD0"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="#E3AD1E"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
