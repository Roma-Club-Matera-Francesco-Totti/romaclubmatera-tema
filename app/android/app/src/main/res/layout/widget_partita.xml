<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Prossima partita": lo scrive WidgetPartita.kt -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rcm_widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <ImageView
        android:layout_width="52dp"
        android:layout_height="60dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/rcm_widget_stemma" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/competizione"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_prossima"
            android:textAllCaps="true"
            android:textColor="#E3AD1E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/squadre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:text="@string/widget_attesa"
            android:textAllCaps="true"
            android:textColor="#F6ECD0"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:textColor="#D9F6ECD0"
            android:textSize="13sp" />

    </LinearLayout>
</LinearLayout>
